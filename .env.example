NODE_ENV=development
PORT=3000

# ─── Base de datos ──────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=3307
DATABASE_USER=devpro_user
DATABASE_PASSWORD=devpro_pass
DATABASE_NAME=devpro_db
DATABASE_SYNCHRONIZE=false
DATABASE_ROOT_PASSWORD=rootpassword

# ─── JWT ─────────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia-este-secret-en-produccion
JWT_EXPIRES_IN=1d

# ─── CORS ────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Facturación electrónica ─────────────────────────────────────────────────────
TOKEN_API_FACTURACION=
URL_API_FACTURACION_QA=

# ─── Circuit Breaker / Retry ─────────────────────────────────────────────────────
CIRCUIT_BREAKER_THRESHOLD=5
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000

# ─── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Sentry (opcional) ────────────────────────────────────────────────────────────
SENTRY_DSN=
